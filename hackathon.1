#include<stdio.h>
#define STUDENTS 10
#define CLASSES 5

int main()
{
    int attendance[STUDENTS][CLASSES];
    int i, j;

    printf("STUDENT ATTENDANCE RECORD\n");
    printf("Enter 1 for Present and 0 for Absent\n\n");

    //Taking attendance
    for(i = 0; i < STUDENTS; i++)
    {
        printf("Student %d:\n", i + 1);

        for(j = 0; j < CLASSES; j++)
        {
            printf("Class %d:", j + 1);
            scanf("%d", &attendance[i][j]);
    
        }

        printf("\n");

    }
    //Display attendance
    printf("\nATTENDANCE REPORT\n");

    printf("Student\t");
    for(j = 0; j < CLASSES; j++)
    {
        printf("C%d\t", j + 1);
    }
    printf("\n");
    for(i = 0; i < STUDENTS; i++)
    {
        printf("%d\t", i + 1);

        for(j = 0; j < CLASSES; j++)
        {
            if(attendance[i][j] == 1)
            printf("P\t");
            else
            printf("A\t");
        }
        printf("\n");

    }
    return 0;
}
